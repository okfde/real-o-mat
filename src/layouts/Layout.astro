---
import '../assets/style.css'
import '@fontsource-variable/montserrat'
import SiteHeader from '../components/SiteHeader.vue'
import logo from '../assets/fragdenstaat.svg'
import Favicon from '../assets/favicon.png'
import OgImage from '../assets/og-image.jpg'
import GradientBackground from '../components/GradientBackground.astro'
import { shareText, publicUrl } from '../const'
import type { Election } from '../content.config'
import IconLink from '~icons/material-symbols/open-in-new'

interface Props {
  title?: string
  election?: Election
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>
      {Astro.props.title ? `${Astro.props.title} – Real-O-Mat` : 'Real-O-Mat'}
    </title>
    <link rel="icon" href={Favicon.src} type="image/png" />
    <meta name="description" content={shareText} />
    <meta property="og:title" content="Real-O-Mat" />
    <meta property="og:description" content={shareText} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={publicUrl} />
    <meta property="og:image" content={OgImage.src} />
  </head>

  <body class="bg-purple-50">
    <!-- Matomo Image Tracker-->
    {
      import.meta.env.PROD && (
        <img
          referrerpolicy="no-referrer-when-downgrade"
          src="https://traffic.okfn.de/matomo.php?idsite=58&rec=1"
          class="absolute -z-10"
          alt=""
        />
      )
    }

    <GradientBackground />

    <div class="flex min-h-screen flex-col pb-12">
      <SiteHeader election={Astro.props.election} client:load />

      <main class="z-10 container mx-auto flex-1 px-4">
        <slot />
      </main>
    </div>

    <footer>
      <div class="bg-gray-50">
        <div class="container mx-auto px-4 py-12 text-gray-600">
          <nav class="flex items-center max-md:flex-col">
            <div>
              <a
                href="https://fragdenstaat.de"
                target="_blank"
                class="inline-block"
              >
                <img src={logo.src} alt="Ein Projekt von FragDenStaat" />
              </a>
            </div>
            <ul
              class="flex flex-col items-center gap-4 max-md:mt-8 md:ms-auto md:flex-row md:gap-12"
            >
              <li>
                <a
                  href="https://wahlbrief.de/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center"
                >
                  <IconLink aria-hidden="true" class="me-1" />
                  Jetzt Briefwahl beantragen
                </a>
              </li>
              <li>
                <a href="https://fragdenstaat.de/impressum" target="_blank">
                  Impressum
                </a>
              </li>
              <li>
                <a href="/datenschutz"> Datenschutz </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
