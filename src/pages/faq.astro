---
import Content from '../layouts/Content.astro'
import { getCollection } from 'astro:content'
import { marked } from 'marked'

const items = (await getCollection('faq')).map((q) => q.data)
---

<Content title="FAQ">
  <h2>FAQ</h2>
  <p>
    {
      items.map((x) => (
        <>
          <h3 set:html={marked.parseInline(x.question)} />
          <div set:html={marked.parse(x.answer)} />
        </>
      ))
    }
  </p>
</Content>
